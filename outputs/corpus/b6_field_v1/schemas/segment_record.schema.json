      "minLength": 1,
      "title": "Segmentation Method",
      "type": "string"
    },
    "segmentation_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Segmentation Version",
      "type": "string"
    },
    "source_id": {
      "pattern": "^(field|synth)_\\d{4}$",
      "title": "Source Id",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "segment_id",
    "source_id",
    "text",
    "char_start",
    "char_end",
    "segmentation_method",
    "segmentation_version"
