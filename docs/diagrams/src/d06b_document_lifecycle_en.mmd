%%{init: {"flowchart": {"nodeSpacing": 10, "rankSpacing": 15}}}%%
flowchart TD
    %% Figure D6b. Document State Machine — Approval, Hash, YAML and Sandbox

    FROM_D6A["From Figure D6a:<br/>Pending Approval or Resolved"]:::partial --> APPROVE_CALL["1. Approval Request<br/>(POST /v2/documents/approve)"]:::impl

    APPROVE_CALL --> CANONICAL_HASH["2. Canonical Hasher SHA-256<br/>(Signature over 11 normative fields)"]:::impl

    CANONICAL_HASH --> APROBADO(["3. State: Aprobado<br/>(approval_metadata sealed)"]):::impl

    APROBADO --> GEN_YAML["4. Governed YAML Generation<br/>(POST /generate-yaml | Gate verifies hash)"]:::impl

    GEN_YAML --> ARTIFACTS["5. Declarative Artifacts Ready<br/>(goals/*.yaml and plans/*.yaml)"]:::impl

    ARTIFACTS --> INSTALL_CALL["6. Sandbox Installation<br/>(POST /experiments/install)"]:::impl

    INSTALL_CALL --> GATE_CHECK{"7. Destination Validation<br/>(validate_target_sandbox)"}:::impl

    GATE_CHECK -- "Original path (RO)" --> SEC_ERR["InstallationSecurityError<br/>(0 writes to core)"]:::partial
    GATE_CHECK -- "Experiment sandbox" --> INSTALLED["Installed with Backup .tar.gz<br/>(EthosTerra_experiment)"]:::impl

    subgraph TAMPERING["Post-Approval Protection"]
        TAMP_NODE["Tampering Detection<br/>If JSON mutates post-signature,<br/>hash mismatch blocks generation"]:::partial
    end

    APROBADO -.-> TAMPERING

    subgraph LEGEND["Status Legend"]
        direction LR
        LEG_IMP["IMPLEMENTED"]:::impl
        LEG_PAR["PARTIAL / CONNECTION"]:::partial
        LEG_PEN["PENDING"]:::pending
    end

    classDef impl fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1b5e20;
    classDef partial fill:#fff8e1,stroke:#f57f17,stroke-width:2px,color:#b78103;
    classDef pending fill:#f1f5f9,stroke:#64748b,stroke-width:2px,stroke-dasharray: 5 5,color:#334155;
