flowchart TD
    %% Figura D12. Frontera Arquitectónica Actual para la Integración de B5 (CRUD de Intenciones)

    subgraph TIER1["1. Entrada y Registro Desacoplado B5 (Implementado)"]
        direction LR
        subgraph ROUTE["API y Acceso"]
            API_R["v2_routes.py e intents_routes.py<br/>(Puntos de montaje)"]:::impl
            API_SEC["Control Acceso y Lista Blanca<br/>(validate_identifier)"]:::impl
            API_R --> API_SEC
        end
        subgraph STORE["Almacén Desacoplado (Implementado)"]
