                EXP_EBDI["EthosTerra_experiment/<br/>data/ebdi/goals/ y plans/<br/>[Destino simulador permitido]"]:::impl
            end
        end
        PROT --> ZONES
    end

    TIER1 --> TIER2
    GATE -.->|"Bloqueo absoluto"| FORBIDDEN
    SAND_SVC -->|"Permitido tras aprobación"| ALLOWED

    subgraph LEYENDA["Leyenda de Estado"]
        direction LR
        LEG_IMP["IMPLEMENTADO (B5 y Barreras)"]:::impl
        LEG_PAR["EN PLANIFICACIÓN (B6)"]:::partial
        LEG_PEN["PENDIENTE (Integración B7)"]:::pending
    end

